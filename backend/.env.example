PLANNER_SYNC_TOKEN=replace-with-long-random-token
PLANNER_WIDGET_TOKEN=replace-with-a-different-read-only-token
PLANNER_DB_PATH=/data/planner.db
PLANNER_ADDR=:443
PLANNER_TLS_CERT=/certs/planner.crt
PLANNER_TLS_KEY=/certs/planner.key

# Telegram input is disabled until every required value below is configured.
PLANNER_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_USER_ID=
PLANNER_TIMEZONE=Europe/Moscow

STT_PRIMARY=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3

# Set to yandex only when both Yandex credentials are configured.
STT_FALLBACK=none
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
